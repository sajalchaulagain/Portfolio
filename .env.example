# ============================================================
# FRONTEND ENVIRONMENT VARIABLES — Mr. Chaule Portfolio
# ============================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values below
# 3. Variables MUST start with VITE_ to be exposed to React
# ============================================================

# Backend API URL
# In development: http://localhost:5000  (proxied via Vite, so /api works directly)
# In production:  https://your-backend-url.com
VITE_API_URL=http://localhost:5000
